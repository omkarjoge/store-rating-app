PORT=5000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=store_ratings

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# Initial system administrator, created automatically by db:init if it does not exist
ADMIN_NAME=System Administrator Account
ADMIN_EMAIL=admin@storeratings.com
ADMIN_PASSWORD=Admin@1234
ADMIN_ADDRESS=Head Office, Platform Admin Address
